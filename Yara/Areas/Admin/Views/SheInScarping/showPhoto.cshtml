
@{
    ViewData["Title"] = "showPhoto";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml"; 
}























@if (ViewBag.ImageUrl != null)
{
    <div>
        <img  id="output" width="450" height="300" src="@ViewBag.ImageUrl" alt="Fetched Image" />
    </div>
    <label >@ViewBag.model</label>
}

else
{
    <p>No images found.</p>
}

